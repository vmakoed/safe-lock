message_text = "Operative, your name surfaced in our final screening.

Before we can deploy you into the field, command requires confirmation of your tactical reasoning and pattern recognition skills.

Unlock the secure vault and access your true objective.

Remember — observation and patience are your greatest assets."
button_text = "Start"

[node name="WinScreen" parent="UI" instance=ExtResource("4_trceg")]
unique_name_in_owner = true
visible = false
layout_mode = 0
message_text = "Operative, your performance exceeded expectations.

Effective immediately, you are cleared for the assignment.

On your mission, you will join other experienced agents.

Further details are classified and will be transmitted through encrypted channels."
button_text = "Next"

